-- FAKE ADMIN (chỉ có trong menu ADMIN): thẻ Developer + dấu Verified trên đầu nhân vật
-- Người chơi thường không thấy (client không đổi được dữ liệu server gửi đi). Người dùng hub cùng server + cùng SYNC_URL thì thấy tag của nhau.
----------------------------------------------------------------
local FakeAdminFeatures = {}
do
    -- FILL: SYNC_URL (URL public của tag_server.js; ai dùng cùng URL thì thấy tag của nhau)
    local SYNC_URL = "http://127.0.0.1:3000" -- 127.0.0.1 = chỉ máy bạn, đổi sang server thật để người khác thấy
    local httpReq = (syn and syn.request) or http_request or request or (http and http.request)
    local VERIFY_GLYPH = utf8.char(0xE000) -- ký tự dấu tích xanh có sẵn của Roblox
    local jobId = (game.JobId ~= "" and game.JobId) or "studio"

    local FA = {dev = false, verify = false}
    local remote = {}                              -- [userId] = {dev, verify} của người dùng hub khác
    local origDist = setmetatable({}, {__mode = "k"}) -- [Humanoid] = kiểu hiện tên gốc

    local function clearTag(char)
        if not char then return end
        for _, d in ipairs(char:GetDescendants()) do
            if d.Name == "BomFakeTag" then d:Destroy() end
        end
    end

    local function hasTag(plr)
        local char = plr.Character
        if not char then return false end
        for _, d in ipairs(char:GetDescendants()) do
            if d.Name == "BomFakeTag" then return true end
        end
        return false
    end

    -- vẽ thẻ lên đầu 1 người chơi (mình hoặc người dùng hub khác)
    local function applyTag(plr, flags)
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        clearTag(char)
        local active = flags and (flags.dev or flags.verify)
        if hum then
            if active then
                if origDist[hum] == nil then origDist[hum] = hum.DisplayDistanceType end
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None -- ẩn tên mặc định để khỏi bị đúp
            elseif origDist[hum] ~= nil then
                hum.DisplayDistanceType = origDist[hum]
                origDist[hum] = nil
            end
        end
        if not active or not head then return end

        local g = Instance.new("BillboardGui")
        g.Name = "BomFakeTag"
        g.Adornee = head
        g.Size = UDim2.fromOffset(240, 56)
        g.StudsOffset = Vector3.new(0, 3.1, 0)
        g.AlwaysOnTop = false
        g.Parent = head

        local lay = Instance.new("UIListLayout")
        lay.SortOrder = Enum.SortOrder.LayoutOrder
        lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
        lay.VerticalAlignment = Enum.VerticalAlignment.Bottom
        lay.Parent = g

        local nm = Instance.new("TextLabel")
        nm.BackgroundTransparency = 1
        nm.Size = UDim2.new(1, 0, 0, 28)
        nm.LayoutOrder = 2
        nm.Font = Enum.Font.GothamBold
        nm.TextSize = 20
        nm.TextColor3 = Color3.new(1, 1, 1)
        nm.TextStrokeTransparency = 0.4
        nm.Text = plr.DisplayName .. (flags.verify and (" " .. VERIFY_GLYPH) or "")
        nm.Parent = g

        if flags.dev then
            local dv = Instance.new("TextLabel")
            dv.BackgroundTransparency = 1
            dv.Size = UDim2.new(1, 0, 0, 20)
            dv.LayoutOrder = 1
            dv.Font = Enum.Font.GothamBold
            dv.TextSize = 14
            dv.TextColor3 = rgb(170, 120, 255)
            dv.TextStrokeTransparency = 0.4
            dv.Text = "</> DEVELOPER"
            dv.Parent = g
        end
    end

    ----------------------------------------------------------
    -- đồng bộ qua relay: người dùng hub cùng server thấy tag của nhau
    ----------------------------------------------------------
    local function api(method, path, body)
        if not httpReq or SYNC_URL == "" then return nil end
        local ok, res = pcall(httpReq, {
            Url = SYNC_URL .. path,
            Method = method,
            Headers = {["Content-Type"] = "application/json"},
            Body = body and HttpService:JSONEncode(body) or nil,
        })
        if not ok or type(res) ~= "table" or res.StatusCode ~= 200 then return nil end
        local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        return ok2 and data or nil
    end

    local function push()
        task.spawn(function()
            api("POST", "/tag", {job = jobId, userId = LocalPlayer.UserId, dev = FA.dev, verify = FA.verify})
        end)
    end

    local function pull()
        local data = api("GET", "/tags?job=" .. HttpService:UrlEncode(jobId))
        if not data or type(data.tags) ~= "table" then return end
        local seen = {}
        for _, t in ipairs(data.tags) do
            local uid = type(t) == "table" and tonumber(t.userId)
            if uid and uid ~= LocalPlayer.UserId then
                local plr = Players:GetPlayerByUserId(uid)
                if plr then
                    seen[uid] = true
                    local flags = {dev = t.dev == true, verify = t.verify == true}
                    local old = remote[uid]
                    if not old or old.dev ~= flags.dev or old.verify ~= flags.verify or not hasTag(plr) then
                        remote[uid] = flags
                        applyTag(plr, flags)
                    end
                end
            end
        end
        for uid in pairs(remote) do
            if not seen[uid] then
                remote[uid] = nil
                local plr = Players:GetPlayerByUserId(uid)
                if plr then applyTag(plr, nil) end
            end
        end
    end

    task.spawn(function()
        if not httpReq or SYNC_URL == "" then return end
        local n = 0
        while ScreenGui.Parent do
            pcall(pull)
            n += 1
            if n % 3 == 0 and (FA.dev or FA.verify) then push() end -- heartbeat ~9s, server giữ thẻ 25s
            task.wait(3)
        end
    end)

    ScreenGui.Destroying:Connect(function()
        FA.dev, FA.verify = false, false
        pcall(function()
            applyTag(LocalPlayer, nil)
            for uid in pairs(remote) do
                local plr = Players:GetPlayerByUserId(uid)
                if plr then applyTag(plr, nil) end
            end
        end)
        push()
    end)

    FakeAdminFeatures.fk_dev = function(v)
        FA.dev = v
        applyTag(LocalPlayer, FA)
        push()
    end
    FakeAdminFeatures.fk_verify = function(v)
        FA.verify = v
        applyTag(LocalPlayer, FA)
        push()
    end
end

