local UIScaleNode = Instance.new("UIScale")
UIScaleNode.Parent = Wrapper

local function targetScale()
    local vp = ScreenGui.AbsoluteSize
    if vp.X < 10 or vp.Y < 10 then
        vp = (workspace.CurrentCamera or Camera).ViewportSize
    end
    local margin = 20
    local scale = math.min((vp.X - margin * 2) / DESIGN_W, (vp.Y - margin * 2) / DESIGN_H, MAX_SCALE)
    return math.clamp(scale, MIN_SCALE, MAX_SCALE)
end

local function fitToScreen()
    if MenuAnimating then return end
    UIScaleNode.Scale = targetScale()
end
