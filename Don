    local TextChatService = game:GetService("TextChatService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local MAX_LEN, COOLDOWN, MAX_ROWS = 200, 1, 100
    local useNew = TextChatService.ChatVersion == Enum.ChatVersion.TextChatService
    local chatConns = {}

    local statusKey = "chat_online"
    local statusLbl = newLabel(PageChat, 11, "SubText")
    statusLbl.Font = Enum.Font.Gotham
    statusLbl.Size = UDim2.new(1, 0, 0, 16)
    statusLbl.Text = T(statusKey)
    local function setStatus(k)
        statusKey = k
