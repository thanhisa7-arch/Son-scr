        TweenService:Create(UIScaleNode, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = base}):Play()
        TweenService:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()
        for _, e in ipairs(ShadowLayers) do
            TweenService:Create(e[1], TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = e[2]}):Play()
        end
        task.delay(0.55, function()
            if menuTok == my then
                MenuAnimating = false
                UIScaleNode.Scale = targetScale()
            end
        end)
    else
        -- TẮT: thu nhỏ nhẹ + mờ dần rồi ẩn
        if not Wrapper.Visible then MenuAnimating = false return end
        TweenService:Create(UIScaleNode, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = base * 0.9}):Play()
        TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1}):Play()
        for _, e in ipairs(ShadowLayers) do
            TweenService:Create(e[1], TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
        end
        task.delay(0.24, function()
            if menuTok ~= my then return end
            Wrapper.Visible = false
            -- trả lại trạng thái gốc để lần mở sau sạch
            Main.GroupTransparency = 0
            for _, e in ipairs(ShadowLayers) do e[1].BackgroundTransparency = e[2] end
            MenuAnimating = false
            UIScaleNode.Scale = targetScale()
        end)
    end
end

