    bp.PaddingRight = UDim.new(0, 12)
    bp.Parent = box
    table.insert(LangUpdaters, function() box.PlaceholderText = T("chat_ph") end)

    local sendBtn = Instance.new("TextButton")
    sendBtn.Position = UDim2.new(1, -76, 0, 0)
    sendBtn.Size = UDim2.fromOffset(76, 38)
    sendBtn.Font = Enum.Font.GothamBold
    sendBtn.TextSize = 13
    sendBtn.TextColor3 = Color3.new(0, 0, 0)
    sendBtn.AutoButtonColor = false
    sendBtn.BorderSizePixel = 0
    themed(sendBtn, "BackgroundColor3", "Accent")
    sendBtn.Parent = inputRow
    corner(sendBtn, 12)
    loc(sendBtn, "chat_send")

    ----------------------------------------------------------
    -- hiển thị tin nhắn
    ----------------------------------------------------------
    local rows, lastSend = {}, 0

    local function esc(s)
        return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
            :gsub('"', "&quot;"):gsub("'", "&apos;"))
    end

    -- TextChatService có thể trả text đã escape sẵn: gỡ trước rồi escape lại để không bị đúp
    local function unesc(s)
        return (tostring(s):gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&quot;", '"')
            :gsub("&apos;", "'"):gsub("&amp;", "&"))
    end

    local function clip(s, n)
        s = tostring(s or "")
        if (utf8.len(s) or #s) > n then
            s = s:sub(1, (utf8.offset(s, n + 1) or (#s + 1)) - 1)
        end
        return s
    end

    local function addMessage(name, userId, text)
        local nearBottom = msgScroll.CanvasPosition.Y + msgScroll.AbsoluteWindowSize.Y
            >= msgScroll.AbsoluteCanvasSize.Y - 40

        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -10, 0, 0)
        row.AutomaticSize = Enum.AutomaticSize.Y
        row.BorderSizePixel = 0
        themed(row, "BackgroundColor3", "Panel")
        place(row, msgScroll)
        row.Parent = msgScroll
        corner(row, 10)
        local rp = Instance.new("UIPadding")
        rp.PaddingTop, rp.PaddingBottom = UDim.new(0, 7), UDim.new(0, 7)
        rp.PaddingLeft, rp.PaddingRight = UDim.new(0, 12), UDim.new(0, 12)
        rp.Parent = row

        local mine = (userId == LocalPlayer.UserId)
        local col = (mine and Theme.Good or Theme.Accent):ToHex()
        local lb = Instance.new("TextLabel")
        lb.BackgroundTransparency = 1
        lb.AutomaticSize = Enum.AutomaticSize.Y
        lb.Size = UDim2.new(1, 0, 0, 0)
        lb.Font = Enum.Font.Gotham
        lb.TextSize = 13
        lb.TextWrapped = true
        lb.RichText = true
        lb.TextXAlignment = Enum.TextXAlignment.Left
        lb.TextYAlignment = Enum.TextYAlignment.Top
        lb.TextColor3 = Theme.Text
        lb.Text = string.format('<font color="#%s"><b>%s</b></font>  %s',
            col, esc(clip(name, 32)), esc(clip(unesc(text), MAX_LEN)))
        lb.Parent = row

        table.insert(rows, row)
        if #rows > MAX_ROWS then table.remove(rows, 1):Destroy() end

        if nearBottom or mine then
            task.defer(function()
                msgScroll.CanvasPosition = Vector2.new(0, msgScroll.AbsoluteCanvasSize.Y)
            end)
        end
    end

    ChatApi.add = addMessage

    ----------------------------------------------------------
    -- nhận tin nhắn của người chơi trong server này
    ----------------------------------------------------------
    if useNew then
        table.insert(chatConns, TextChatService.MessageReceived:Connect(function(m)
            local src = m.TextSource
            if not src then return end -- bỏ tin hệ thống
            local plr = Players:GetPlayerByUserId(src.UserId)
            addMessage(plr and plr.DisplayName or src.Name, src.UserId, m.Text)
        end))
    else
        local hooked = {}
        local function hook(p)
            if hooked[p] then return end
            hooked[p] = true
            table.insert(chatConns, p.Chatted:Connect(function(msg)
                addMessage(p.DisplayName, p.UserId, msg)
            end))
        end
        for _, p in ipairs(Players:GetPlayers()) do hook(p) end
        table.insert(chatConns, Players.PlayerAdded:Connect(hook))
    end

    ScreenGui.Destroying:Connect(function()
        for _, c in ipairs(chatConns) do c:Disconnect() end
    end)

    ----------------------------------------------------------
    -- gửi tin nhắn (qua chat gốc của game)
    ----------------------------------------------------------
    local function send()
        local txt = clip(box.Text:match("^%s*(.-)%s*$") or "", MAX_LEN)
        if txt == "" then return end
        if os.clock() - lastSend < COOLDOWN then
            setStatus("chat_cooldown")
            task.delay(1.5, function() setStatus("chat_online") end)
            return
        end

        local ok = false
        if useNew then
            local channels = TextChatService:FindFirstChild("TextChannels")
            local ch = channels and channels:FindFirstChild("RBXGeneral")
            if ch then ok = pcall(function() ch:SendAsync(txt) end) end
        else
            local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            local say = ev and ev:FindFirstChild("SayMessageRequest")
            if say then ok = pcall(function() say:FireServer(txt, "All") end) end
        end

        if ok then
            lastSend = os.clock()
            box.Text = ""
            setStatus("chat_online")
        else
            setStatus("chat_nochannel")
            task.delay(2, function() setStatus("chat_online") end)
        end
    end

    sendBtn.MouseButton1Click:Connect(send)
    box.FocusLost:Connect(function(enter) if enter then send() end end)
end

