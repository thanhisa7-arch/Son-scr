local FLY_SPEED, FLY2_SPEED = 60, 70

-- Bay (V1): bay thẳng theo camera
local function fly(on)
    unbind("fly")
    local root, hum = getRoot(), getHum()
    if root then
        local bv = root:FindFirstChild("BomFlyVel")
        local bg = root:FindFirstChild("BomFlyGyro")
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end
    if hum then hum.PlatformStand = false end
    if not on then return end

    bind("fly", RunService.RenderStepped:Connect(function()
        local r, h = getRoot(), getHum()
        local cam = workspace.CurrentCamera
        if not r or not h or not cam then return end
        h.PlatformStand = true

        local bv = r:FindFirstChild("BomFlyVel")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "BomFlyVel"
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Velocity = Vector3.zero
            bv.Parent = r
        end
        local bg = r:FindFirstChild("BomFlyGyro")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = "BomFlyGyro"
            bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            bg.P = 9e4
            bg.Parent = r
        end

        local cf = cam.CFrame
        local move = cf:VectorToObjectSpace(h.MoveDirection)
        bv.Velocity = (cf.LookVector * (-move.Z) + cf.RightVector * move.X) * FLY_SPEED
        bg.CFrame = cf
    end))
end

-- Bay V2: gia tốc mượt, nghiêng người + nghiêng hông theo hướng bay, lơ lửng nhẹ khi đứng yên.
local function fly2(on)
    unbind("fly2")
    local root, hum = getRoot(), getHum()
    if root then
        for _, n in ipairs({"BomFly2Vel", "BomFly2Gyro"}) do
            local o = root:FindFirstChild(n)
            if o then o:Destroy() end
        end
    end
    if hum then hum.PlatformStand = false end
    if not on then return end

    local vel, lean, roll = Vector3.zero, 0, 0
    bind("fly2", RunService.RenderStepped:Connect(function(dt)
        local r, h = getRoot(), getHum()
        local cam = workspace.CurrentCamera
        if not r or not h or not cam then return end
        h.PlatformStand = true

        local bv = r:FindFirstChild("BomFly2Vel")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "BomFly2Vel"
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Velocity = Vector3.zero
            bv.Parent = r
        end
        local bg = r:FindFirstChild("BomFly2Gyro")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = "BomFly2Gyro"
            bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            bg.P = 9e4
            bg.Parent = r
        end

        local cf = cam.CFrame
        local move = cf:VectorToObjectSpace(h.MoveDirection)
        local wish = cf.LookVector * (-move.Z) + cf.RightVector * move.X
        if wish.Magnitude > 1 then wish = wish.Unit end
        local target = wish * FLY2_SPEED
        if wish.Magnitude < 0.05 then
            target = Vector3.new(0, math.sin(os.clock() * 2.2) * 2.5, 0) -- lơ lửng nhẹ
        end

        local a = 1 - math.exp(-7 * dt)
        vel = vel:Lerp(target, a)
        bv.Velocity = vel

        local rel = cf:VectorToObjectSpace(vel) / math.max(FLY2_SPEED, 1)
        lean = lean + (math.clamp(rel.Z, -1, 1) * math.rad(50) - lean) * a
        roll = roll + (math.clamp(-rel.X, -1, 1) * math.rad(28) - roll) * a
        local yaw = math.atan2(-cf.LookVector.X, -cf.LookVector.Z)
        bg.CFrame = CFrame.Angles(0, yaw, 0) * CFrame.Angles(lean, 0, roll)
    end))
end

local SPEED_VALUE = 50
local function speed(on)
    unbind("speed")
    local hum = getHum()
    if on then
