-- HALLOWEEN JJS: định vị cửa + steal door fast
-- Tìm cửa theo TÊN (game có thể đổi tên object). Nếu không thấy cửa nào, sửa KEYWORDS bên dưới.
----------------------------------------------------------------
local HwFeatures, HwRows = {}, {}
do
    -- FILL: KEYWORDS (từ khóa trong tên cửa / ObjectText / ActionText của ProximityPrompt)
    local KEYWORDS = {"door", "pumpkin", "trick", "treat"}
    local EXCLUDE = {"shop", "portal", "candy"}

    local Doors = {}                 -- [prompt] = {part, hold, los, hl, gui, label}
    local on = {esp = false, steal = false}
    local tracking = false
    local tries = {}
    local folder = Instance.new("Folder")
    folder.Name = "BomHwEsp"
    folder.Parent = ScreenGui

    local function hit(str, list)
        str = string.lower(str or "")
        for _, k in ipairs(list or KEYWORDS) do
            if string.find(str, k, 1, true) then return true end
        end
        return false
    end

    local function anchorOf(pp)
        local p = pp.Parent
        if p and p:IsA("Attachment") then p = p.Parent end
        if p and p:IsA("BasePart") then return p end
        local m = pp:FindFirstAncestorOfClass("Model")
        if m then return m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true) end
        return nil
    end

    local function isDoor(pp)
        if hit(pp.Name, EXCLUDE) or hit(pp.ObjectText, EXCLUDE) or hit(pp.ActionText, EXCLUDE) then return false end
        local found = hit(pp.Name) or hit(pp.ObjectText) or hit(pp.ActionText)
        local p = pp.Parent
        for _ = 1, 5 do
            if not p or p == workspace then break end
            if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then return false end -- bỏ qua nhân vật
            if hit(p.Name, EXCLUDE) then return false end
            if hit(p.Name) then found = true end
            p = p.Parent
        end
        return found
    end

    local function makeEsp(pp)
        local d = Doors[pp]
        if not d or d.hl then return end
        local target = d.part
        local m = d.part:FindFirstAncestorOfClass("Model")
        if m and hit(m.Name) then target = m end

        local hl = Instance.new("Highlight")
        hl.Adornee = target
        hl.FillColor = rgb(255, 140, 0)
        hl.OutlineColor = Color3.new(1, 1, 1)
        hl.FillTransparency = 0.55
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = folder

        local gui = Instance.new("BillboardGui")
        gui.Adornee = d.part
        gui.AlwaysOnTop = true
        gui.Size = UDim2.fromOffset(160, 40)
        gui.StudsOffset = Vector3.new(0, 3, 0)
        gui.Parent = folder

        local lb = Instance.new("TextLabel")
        lb.BackgroundTransparency = 1
        lb.Size = UDim2.fromScale(1, 1)
        lb.Font = Enum.Font.GothamBold
        lb.TextSize = 15
        lb.TextColor3 = rgb(255, 160, 40)
        lb.TextStrokeTransparency = 0.3
        lb.Text = "DOOR"
        lb.Parent = gui

        d.hl, d.gui, d.label = hl, gui, lb
    end

    local function removeEsp(d)
        if d.hl then d.hl:Destroy() d.hl = nil end
        if d.gui then d.gui:Destroy() d.gui = nil end
        d.label = nil
    end

    local function setFast(pp, d, fast)
        pcall(function()
            if fast then
                pp.HoldDuration = 0
                pp.RequiresLineOfSight = false
            else
                pp.HoldDuration = d.hold
                pp.RequiresLineOfSight = d.los
            end
        end)
    end

    local function add(inst)
        if Doors[inst] or not inst:IsA("ProximityPrompt") then return end
        if not isDoor(inst) then return end
        local part = anchorOf(inst)
        if not part then return end
        local d = {part = part, hold = inst.HoldDuration, los = inst.RequiresLineOfSight}
        Doors[inst] = d
        if on.steal then setFast(inst, d, true) end
        if on.esp then makeEsp(inst) end
    end

    local function drop(pp)
        local d = Doors[pp]
        if d then
            removeEsp(d)
            Doors[pp] = nil
        end
    end

    local function setRows(count, near)
        if HwRows.count then HwRows.count.Text = count end
        if HwRows.near then HwRows.near.Text = near end
    end

    local function refreshTracking()
        local need = on.esp or on.steal
        if need and not tracking then
            tracking = true
            task.spawn(function()
                local n = 0
                for _, d in ipairs(workspace:GetDescendants()) do
                    if not tracking then return end
                    pcall(add, d)
                    n += 1
                    if n % 400 == 0 then task.wait() end
                end
            end)
            bind("hw_add", workspace.DescendantAdded:Connect(function(d) pcall(add, d) end))
            bind("hw_rem", workspace.DescendantRemoving:Connect(function(d)
                if Doors[d] then drop(d) end
            end))

            local acc = 0
            bind("hw_loop", RunService.Heartbeat:Connect(function(dt)
                acc += dt
                if acc < 0.1 then return end
                acc = 0
                local root = getRoot()

                local n, nearest = 0, nil
                for pp, d in pairs(Doors) do
                    if not pp.Parent or not d.part.Parent then
                        drop(pp)
                    else
                        n += 1
                        local dist = root and (d.part.Position - root.Position).Magnitude or nil
                        if dist and (not nearest or dist < nearest) then nearest = dist end
                        if d.label and dist then d.label.Text = string.format("DOOR  %dm", math.floor(dist + 0.5)) end
                    end
                end
                setRows(tostring(n), nearest and (math.floor(nearest + 0.5) .. " studs") or "-")
            end))
        elseif not need and tracking then
            tracking = false
            unbind("hw_add")
            unbind("hw_rem")
            unbind("hw_loop")
            for pp, d in pairs(Doors) do
                setFast(pp, d, false)
                removeEsp(d)
                Doors[pp] = nil
            end
            tries = {}
            setRows("-", "-")
        end
    end

    -- chỉ chạy khi BẠN bấm nút: dịch chuyển tới cửa gần nhất rồi mở một lần
    HwRows.go = function()
        local root, hum = getRoot(), getHum()
        if not tracking or not root or not hum or hum.Health <= 0 then return false end
        local best, bestDist, bd
        for pp, d in pairs(Doors) do
            if pp.Parent and d.part.Parent and pp.Enabled then
                local dist = (d.part.Position - root.Position).Magnitude
                if not bestDist or dist < bestDist then best, bestDist, bd = pp, dist, d end
            end
        end
        if not best then return false end
        setFast(best, bd, true)
        if bestDist > 6 then
            local dir = root.Position - bd.part.Position
            dir = Vector3.new(dir.X, 0, dir.Z)
            dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
            root.CFrame = CFrame.new(bd.part.Position + dir * 3.5 + Vector3.new(0, 2, 0), bd.part.Position)
        end
        task.spawn(function()
            task.wait(0.08)
            if fireproximityprompt then
                pcall(fireproximityprompt, best)
            else
                pcall(function()
                    best:InputHoldBegin()
                    task.wait(0.05)
                    best:InputHoldEnd()
                end)
            end
        end)
        return true
    end

    HwFeatures.hw_esp = function(v)
        on.esp = v
        if v then
            for pp in pairs(Doors) do makeEsp(pp) end
        else
            for _, d in pairs(Doors) do removeEsp(d) end
        end
        refreshTracking()
    end

    HwFeatures.hw_steal = function(v)
        on.steal = v
        for pp, d in pairs(Doors) do setFast(pp, d, v) end
        refreshTracking()
    end
end

