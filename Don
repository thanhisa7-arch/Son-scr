local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64_LOOKUP = {}
for i = 1, #B64_CHARS do B64_LOOKUP[B64_CHARS:byte(i)] = i - 1 end

local function b64decode(s)
    s = s:gsub("%s", "")
    local out = {}
    for i = 1, #s, 4 do
        local a, b, c, d = s:byte(i, i + 3)
        local n = (B64_LOOKUP[a] or 0) * 262144 + (B64_LOOKUP[b] or 0) * 4096
            + (B64_LOOKUP[c] or 0) * 64 + (B64_LOOKUP[d] or 0)
        local b1, b2, b3 = math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256
        if c == 61 then
            out[#out + 1] = string.char(b1)
        elseif d == 61 then
            out[#out + 1] = string.char(b1, b2)
        else
            out[#out + 1] = string.char(b1, b2, b3)
        end
    end
    return table.concat(out)
end

local function loadToggleImage()
    if TOGGLE_IMAGE_ID ~= "" then return TOGGLE_IMAGE_ID end
    local ok, result = pcall(function()
        local getAsset = getcustomasset or getsynasset
        if not (writefile and getAsset) then return nil end
        local path = "BomHub_toggle.jpg"
        writefile(path, b64decode(TOGGLE_IMG_B64))
        return getAsset(path)
    end)
    if ok and result and result ~= "" then return result end
    return nil
end

