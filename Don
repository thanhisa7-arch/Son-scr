local function makeDraggableToggleGroup(handle, target, onTap)
    local dragInput, moved, dragStart, startPos
    local DRAG_THRESHOLD = IS_TOUCH and 10 or 6

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
            moved = false
            dragStart = input.Position
            startPos = target.Position
        end
    end)

    table.insert(DragConns, UserInputService.InputChanged:Connect(function(input)
        if not dragInput then return end
        local isMove = (dragInput.UserInputType == Enum.UserInputType.Touch and input == dragInput)
            or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseMovement)
        if isMove then
            local delta = input.Position - dragStart
            if delta.Magnitude > DRAG_THRESHOLD then moved = true end
            if moved then
                target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                             startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end))

    table.insert(DragConns, UserInputService.InputEnded:Connect(function(input)
        if dragInput and (input == dragInput
            or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            local wasMoved = moved
            dragInput = nil
            if not wasMoved then onTap() end
        end
    end))
end

makeDraggableToggleGroup(ToggleBtn, ToggleWrapper, function()
    setMenuVisible(not Wrapper.Visible)
end)

