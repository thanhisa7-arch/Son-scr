}

local Theme = {Text = rgb(245, 248, 255), SubText = rgb(140, 160, 200)}
local THEME_KEYS = {"Panel", "Card", "CardHi", "Accent", "Good"}

local function setThemeFromPreset(p)
    for _, k in ipairs(THEME_KEYS) do Theme[k] = p[k] end
end

local function setThemeFromHue(h)
    Theme.Accent = Color3.fromHSV(h, 0.75, 1)
    Theme.Panel  = Color3.fromHSV(h, 0.65, 0.10)
    Theme.Card   = Color3.fromHSV(h, 0.55, 0.19)
    Theme.CardHi = Color3.fromHSV(h, 0.50, 0.27)
    Theme.Good   = (h > 0.2 and h < 0.45) and rgb(255, 214, 90) or rgb(80, 220, 140)
end

do
    if Settings.preset == "custom" then
        setThemeFromHue(Settings.hue)
    else
        local found
        for _, p in ipairs(Presets) do
            if p.id == Settings.preset then found = p end
        end
        setThemeFromPreset(found or Presets[1])
    end
end

-- registry: mọi thứ có màu theme đều đăng ký ở đây để đổi màu đồng loạt
local Themed, ThemeUpdaters = {}, {}

local function themed(inst, prop, key)
    table.insert(Themed, {inst, prop, key})
    inst[prop] = Theme[key]
    return inst
end

local function applyTheme()
    for i = #Themed, 1, -1 do
        local e = Themed[i]
        if e[1] and e[1].Parent then
            e[1][e[2]] = Theme[e[3]]
        else
            table.remove(Themed, i)
        end
    end
    for _, fn in ipairs(ThemeUpdaters) do pcall(fn) end
end

