    end
    table.insert(LangUpdaters, function() statusLbl.Text = T(statusKey) end)

    local msgScroll = Instance.new("ScrollingFrame")
    msgScroll.Position = UDim2.fromOffset(0, 22)
    msgScroll.Size = UDim2.new(1, 0, 1, -68)
    msgScroll.BackgroundTransparency = 1
    msgScroll.BorderSizePixel = 0
    msgScroll.ScrollBarThickness = 4
    msgScroll.CanvasSize = UDim2.new()
    msgScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    themed(msgScroll, "ScrollBarImageColor3", "Accent")
    msgScroll.Parent = PageChat
    local ml = Instance.new("UIListLayout")
    ml.Padding = UDim.new(0, 6)
