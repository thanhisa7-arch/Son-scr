local LagFeatures, LAG_IDS = {}, {"lag_fx", "lag_shadow", "lag_post", "lag_mat", "lag_quality", "lag_water", "lag_fps"}
do
local Lighting = game:GetService("Lighting")
local LagOn, LagSaved = {}, {fx = {}, mat = {}, post = {}}

local FX_CLASSES = {ParticleEmitter = true, Trail = true, Beam = true, Smoke = true, Fire = true, Sparkles = true}
local POST_CLASSES = {BloomEffect = true, BlurEffect = true, ColorCorrectionEffect = true,
    DepthOfFieldEffect = true, SunRaysEffect = true}

-- duyệt cây theo từng lượt nhỏ để không giật máy
local function lagScan(root, flag, handle)
    task.spawn(function()
        local n = 0
        for _, d in ipairs(root:GetDescendants()) do
            if not LagOn[flag] then return end
            pcall(handle, d)
            n += 1
            if n % 300 == 0 then task.wait() end
        end
    end)
end

local function lagFx(on)
    LagOn.fx = on
    unbind("lag_fx")
    if not on then
        for inst, was in pairs(LagSaved.fx) do pcall(function() inst.Enabled = was end) end
        LagSaved.fx = {}
        return
    end
    local function handle(d)
        if FX_CLASSES[d.ClassName] and LagSaved.fx[d] == nil then
            LagSaved.fx[d] = d.Enabled
            d.Enabled = false
        end
    end
    lagScan(workspace, "fx", handle)
    bind("lag_fx", workspace.DescendantAdded:Connect(function(d) pcall(handle, d) end))
end

local function lagShadow(on)
    LagOn.shadow = on
    if on then
        if LagSaved.shadow == nil then LagSaved.shadow = Lighting.GlobalShadows end
        Lighting.GlobalShadows = false
    elseif LagSaved.shadow ~= nil then
        Lighting.GlobalShadows = LagSaved.shadow
        LagSaved.shadow = nil
    end
end

local function lagPost(on)
    LagOn.post = on
    unbind("lag_post")
    if not on then
        for inst, was in pairs(LagSaved.post) do pcall(function() inst.Enabled = was end) end
        LagSaved.post = {}
        return
    end
    local function handle(d)
        if POST_CLASSES[d.ClassName] and LagSaved.post[d] == nil then
            LagSaved.post[d] = d.Enabled
            d.Enabled = false
        end
    end
    lagScan(Lighting, "post", handle)
    local cam = workspace.CurrentCamera
    if cam then lagScan(cam, "post", handle) end
    bind("lag_post", Lighting.DescendantAdded:Connect(function(d) pcall(handle, d) end))
end

local function lagMat(on)
    LagOn.mat = on
    unbind("lag_mat")
    if not on then
        for part, old in pairs(LagSaved.mat) do
            pcall(function()
                part.Material = old[1]
                part.Reflectance = old[2]
            end)
        end
        LagSaved.mat = {}
        return
    end
    local function handle(d)
        if d:IsA("BasePart") and not d:IsA("Terrain") and d.Name ~= "BomAirPad" and LagSaved.mat[d] == nil then
            LagSaved.mat[d] = {d.Material, d.Reflectance}
            d.Material = Enum.Material.SmoothPlastic
            d.Reflectance = 0
        end
    end
    lagScan(workspace, "mat", handle)
    bind("lag_mat", workspace.DescendantAdded:Connect(function(d) pcall(handle, d) end))
end

local function lagQuality(on)
    LagOn.quality = on
    pcall(function()
        local r = settings().Rendering
        if on then
            if LagSaved.quality == nil then LagSaved.quality = r.QualityLevel end
            r.QualityLevel = Enum.QualityLevel.Level01
        elseif LagSaved.quality ~= nil then
            r.QualityLevel = LagSaved.quality
            LagSaved.quality = nil
        end
    end)
end

local function lagWater(on)
    LagOn.water = on
    local t = workspace:FindFirstChildOfClass("Terrain")
    if not t then return end
    if on then
        if not LagSaved.water then
            LagSaved.water = {}
            for _, k in ipairs({"WaterWaveSize", "WaterWaveSpeed", "WaterReflectance", "Decoration"}) do
                pcall(function() LagSaved.water[k] = t[k] end)
            end
        end
        pcall(function() t.WaterWaveSize = 0 end)
        pcall(function() t.WaterWaveSpeed = 0 end)
        pcall(function() t.WaterReflectance = 0 end)
        pcall(function() t.Decoration = false end)
    elseif LagSaved.water then
        for k, v in pairs(LagSaved.water) do pcall(function() t[k] = v end) end
        LagSaved.water = nil
    end
end

local function lagFps(on)
    LagOn.fps = on
    if setfpscap then
        pcall(setfpscap, on and 999 or 60)
    else
        warn("[BomHub] executor không hỗ trợ setfpscap")
    end
end


LagFeatures.lag_fx, LagFeatures.lag_shadow, LagFeatures.lag_post, LagFeatures.lag_mat = lagFx, lagShadow, lagPost, lagMat
LagFeatures.lag_quality, LagFeatures.lag_water, LagFeatures.lag_fps = lagQuality, lagWater, lagFps
end


