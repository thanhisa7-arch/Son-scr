        Saved.walk = nil
    end
end

local SPEED2_VALUE = 80
local function speed2(on)
    unbind("speed2")
    if not on then return end
    local cur = Vector3.zero
    bind("speed2", RunService.Heartbeat:Connect(function(dt)
        local r, h = getRoot(), getHum()
        if not r or not h then return end
        local extra = math.max(SPEED2_VALUE - h.WalkSpeed, 0)
        cur = cur:Lerp(h.MoveDirection * extra, math.clamp(dt * 10, 0, 1))
        if cur.Magnitude > 0.05 then r.CFrame = r.CFrame + cur * dt end
    end))
end

