local function tween(o, props, t)
    if IS_TOUCH then return end
    TweenService:Create(o, TweenInfo.new(t or 0.15), props):Play()
end

local function corner(inst, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = inst
    return c
end

local function stroke(inst, key, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Transparency = transparency == nil and 0.35 or transparency
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    themed(s, "Color", key or "Accent")
    s.Parent = inst
    return s
end

local Orders = {}
local function place(inst, parent)
    Orders[parent] = (Orders[parent] or 0) + 1
    inst.LayoutOrder = Orders[parent]
end

local function newLabel(parent, size, colorKey, xAlign)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamBold
    l.TextSize = size
    l.TextXAlignment = xAlign or Enum.TextXAlignment.Left
    themed(l, "TextColor3", colorKey or "Text")
    l.Parent = parent
    return l
end

