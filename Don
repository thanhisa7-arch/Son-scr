local SETTINGS_FILE = "BomHub_settings.json"
local Settings = {lang = "vi", preset = "blue", hue = 0.6, island = true, islandX = 0, islandY = 10}

pcall(function()
    if isfile and readfile and isfile(SETTINGS_FILE) then
        local data = HttpService:JSONDecode(readfile(SETTINGS_FILE))
        if type(data) == "table" then
            if data.lang == "vi" or data.lang == "en" then Settings.lang = data.lang end
            if type(data.preset) == "string" then Settings.preset = data.preset end
            if type(data.hue) == "number" then Settings.hue = math.clamp(data.hue, 0, 1) end
            if type(data.island) == "boolean" then Settings.island = data.island end
            if data.role == "admin" or data.role == "member" then Settings.role = data.role end
            if type(data.islandX) == "number" then Settings.islandX = math.clamp(data.islandX, -3000, 3000) end
            if type(data.islandY) == "number" then Settings.islandY = math.clamp(data.islandY, 0, 3000) end
        end
    end
end)

local function saveSettings()
    pcall(function()
        if writefile then writefile(SETTINGS_FILE, HttpService:JSONEncode(Settings)) end
    end)
end

