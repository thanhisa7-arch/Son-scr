    d = "đĐ",
}) do
    for _, cp in utf8.codes(chars) do VN_MAP[cp] = ascii end
end

local function fold(s)
    local out = {}
    local ok = pcall(function()
        for _, cp in utf8.codes(s) do
            table.insert(out, VN_MAP[cp] or utf8.char(cp))
        end
    end)
    if not ok then return s:lower() end
    return table.concat(out):lower()
end

