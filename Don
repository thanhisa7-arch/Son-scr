        P.paintSwitch(true)
    end
    row.MouseButton1Click:Connect(toggle)

    ----------------------------------------------------------
    -- thanh tốc độ
    ----------------------------------------------------------
    function P.paintSlider(animate)
        local v = def.get()
        local rel = math.clamp((v - def.min) / (def.max - def.min), 0, 1)
        vl.Text = tostring(v)
        if animate then
            TweenService:Create(fill, EASE_FAST, {Size = UDim2.fromScale(rel, 1)}):Play()
            TweenService:Create(sk, EASE_FAST, {Position = UDim2.new(rel, 0, 0.5, 0)}):Play()
        else
            fill.Size = UDim2.fromScale(rel, 1)
            sk.Position = UDim2.new(rel, 0, 0.5, 0)
        end
    end

    local dragging = false
    local function fromX(px)
        local rel = math.clamp((px - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        def.set(math.floor(def.min + (def.max - def.min) * rel + 0.5))
        P.paintSlider(true)
    end
    box.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            TweenService:Create(sk, EASE_FAST, {Size = UDim2.fromOffset(SK + 4, SK + 4)}):Play()
            fromX(input.Position.X)
        end
    end)
    bind("pp_mv_" .. id, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            fromX(input.Position.X)
        end
    end))
    bind("pp_end_" .. id, UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            TweenService:Create(sk, EASE_OUT, {Size = UDim2.fromOffset(SK, SK)}):Play()
        end
    end))

    ----------------------------------------------------------
    -- mở / đóng
    ----------------------------------------------------------
    function P.open()
        P.isOpen = true
        topZ += 1
        h.ZIndex = topZ
        if not P.placed then
            P.placed = true
            h.Position = UDim2.new(0.68, openCount * 20, 0.5, openCount * 20 - 10)
            openCount += 1
        end
        P.tok += 1
        local tok = P.tok
        stopFx()
        P.paintSwitch(false)
        P.paintSlider(false)

        -- mở: mờ dần hiện + phóng nhẹ + nổi lên một chút, không nảy
        h.Visible = true
        local base = miniBase()
        P.base = base
        sc.Scale = base * (def.anim and 0.9 or 0.95)
        g.GroupTransparency = 1
        g.Position = UDim2.new(0.5, 0, 0.5, 10)
        local info = def.anim and EASE_SLOW or EASE_OUT
        TweenService:Create(sc, info, {Scale = base}):Play()
        TweenService:Create(g, info, {GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5)}):Play()

        -- hai hàng nổi lên lần lượt, rất nhẹ
        for i, r in ipairs(P.rows) do
            r.obj.Position = r.home + UDim2.fromOffset(0, 8)
            task.delay((def.anim and 0.07 or 0.04) * i, function()
                if tok ~= P.tok then return end
                TweenService:Create(r.obj, EASE_SLOW, {Position = r.home}):Play()
            end)
        end
    end

    function P.hide(instant)
        P.isOpen = false
        P.tok += 1
        local tok = P.tok
        stopFx()
        local function finish()
            if tok ~= P.tok then return end
            h.Visible = false
        end
        if instant then
            finish()
        else
            TweenService:Create(sc, EASE_IN, {Scale = (P.base or 1) * 0.96}):Play()
            TweenService:Create(g, EASE_IN, {GroupTransparency = 1,
                Position = UDim2.new(0.5, 0, 0.5, 6)}):Play()
            task.delay(0.19, finish)
        end
    end

    x.MouseButton1Click:Connect(function() P.hide() end)
    return P
end

