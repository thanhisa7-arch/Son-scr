    table.insert(ThemeUpdaters, refresh)
    table.insert(LangUpdaters, refresh)
    Wrapper:GetPropertyChangedSignal("Visible"):Connect(refresh)

    local function setState(new)
        tok += 1
        local my = tok
        local old = state
        state = new
        local sz = SIZES[new]
        local info = (new == "compact")
            and TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            or TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        TweenService:Create(island, info, {Size = UDim2.fromOffset(sz.w, sz.h)}):Play()
        TweenService:Create(islandCorner, info, {CornerRadius = UDim.new(0, sz.r)}):Play()

        if new == old then return end
        local prev, nxt = containers[old], containers[new]
        TweenService:Create(prev, TweenInfo.new(0.12), {GroupTransparency = 1}):Play()
        task.delay(0.13, function()
            if tok == my then prev.Visible = false end
        end)
        nxt.Visible = true
        nxt.GroupTransparency = 1
        task.delay(0.1, function()
            if tok == my then
                TweenService:Create(nxt, TweenInfo.new(0.22), {GroupTransparency = 0}):Play()
            end
        end)
    end

    -- khởi tạo: hiện bản thu gọn
    cC.Visible = true
    cC.GroupTransparency = 0
    refresh()

    task.spawn(function()
        while ScreenGui.Parent do
            refresh()
            task.wait(0.5)
        end
    end)

    local function tap()
        if state == "full" then
            setState("compact")
        else
            refresh()
            setState("full")
            local my = tok
            task.delay(8, function()
                if tok == my and state == "full" then setState("compact") end
            end)
        end
    end

    -- kéo để di chuyển, chạm nhẹ để mở / thu bảng
    local DRAG_THRESHOLD = IS_TOUCH and 10 or 6
    local dragInput, moved, dragStart, startPos

    local function isPress(i)
        return i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch
    end

    hit.InputBegan:Connect(function(input)
        if isPress(input) and not dragInput then
            dragInput, moved = input, false
            dragStart, startPos = input.Position, island.Position
        end
    end)

    bind("island_move", UserInputService.InputChanged:Connect(function(input)
        if not dragInput then return end
        if input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            if d.Magnitude > DRAG_THRESHOLD then moved = true end
            if moved then
                island.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                            startPos.Y.Scale, math.max(0, startPos.Y.Offset + d.Y))
            end
        end
    end))

    bind("island_end", UserInputService.InputEnded:Connect(function(input)
        if not dragInput then return end
        if input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1) then
            local wasMoved = moved
            dragInput = nil
            if wasMoved then
                Settings.islandX = island.Position.X.Offset
                Settings.islandY = island.Position.Y.Offset
                saveSettings()
            else
                tap()
            end
        end
    end))

    fBtn.MouseButton1Click:Connect(function()
        setMenuVisible(not Wrapper.Visible)
    end)

    -- được gọi mỗi khi một tính năng bật/tắt
    setIslandEnabled = function(on)
        Settings.island = on
        island.Visible = on
        saveSettings()
    end

    islandNotify = function(id, on)
        if not Settings.island then return end
        local col = on and Theme.Good or Theme.SubText
        tName.Text = T("sc_" .. id)
        tState.Text = T(on and "isl_on" or "isl_off")
        tState.TextColor3 = col
        tDot.BackgroundColor3 = col
        refresh()
        if state == "full" then return end
        setState("toast")
        local my = tok
        task.delay(2.2, function()
            if tok == my and state == "toast" then setState("compact") end
        end)
    end
end

